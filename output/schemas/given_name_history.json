{
  "$id": "given_name_history",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "subject",
    "attribute",
    "cutOffTime",
    "history"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "required": [
        "identifier",
        "type"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "$id": "InszNumber"
        },
        "type": {
          "type": "string",
          "const": "RegisteredNaturalPerson"
        }
      }
    },
    "attribute": {
      "type": "object",
      "required": [
        "attribute"
      ],
      "properties": {
        "attribute": {
          "type": "string",
          "const": "GivenName"
        }
      }
    },
    "cutOffTime": {
      "type": "string",
      "$id": "DateTime",
      "format": "datetime"
    },
    "history": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "$id": "GivenName"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "effectivityStart"
            ],
            "properties": {
              "effectivityStart": {
                "anyOf": [
                  {
                    "type": "string",
                    "$id": "DateTime",
                    "format": "datetime"
                  },
                  {
                    "type": "string",
                    "$id": "Date",
                    "format": "date-time"
                  },
                  {
                    "type": "string",
                    "$id": "Month"
                  },
                  {
                    "type": "string",
                    "$id": "Year"
                  }
                ],
                "$id": "TemporalPosition"
              },
              "effectivityEnd": {
                "anyOf": [
                  {
                    "type": "string",
                    "$id": "DateTime",
                    "format": "datetime"
                  },
                  {
                    "type": "string",
                    "$id": "Date",
                    "format": "date-time"
                  },
                  {
                    "type": "string",
                    "$id": "Month"
                  },
                  {
                    "type": "string",
                    "$id": "Year"
                  }
                ],
                "$id": "TemporalPosition"
              }
            }
          }
        ]
      }
    }
  }
}