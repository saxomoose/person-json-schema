{
  "$id": "given_name_lineage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "subject",
    "attribute",
    "evaluationTime",
    "lineage"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "required": [
        "identifier",
        "type"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "$id": "InszNumber"
        },
        "type": {
          "type": "string",
          "const": "RegisteredNaturalPerson"
        }
      }
    },
    "attribute": {
      "type": "string",
      "const": "GivenName"
    },
    "evaluationTime": {
      "type": "string",
      "$id": "DateTime",
      "format": "datetime"
    },
    "lineage": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "allOf": [
              {
                "allOf": [
                  {
                    "allOf": [
                      {
                        "type": "object",
                        "required": [
                          "identifier",
                          "occurenceTime"
                        ],
                        "properties": {
                          "identifier": {
                            "type": "string",
                            "$id": "Identifier"
                          },
                          "occurenceTime": {
                            "anyOf": [
                              {
                                "type": "string",
                                "$id": "DateTime",
                                "format": "datetime"
                              },
                              {
                                "type": "string",
                                "$id": "Date",
                                "format": "date-time"
                              },
                              {
                                "type": "string",
                                "$id": "Month"
                              },
                              {
                                "type": "string",
                                "$id": "Year"
                              }
                            ],
                            "$id": "TemporalPosition"
                          }
                        }
                      }
                    ],
                    "$id": "LegalEvent"
                  }
                ],
                "$id": "LegalAct"
              },
              {
                "type": "object",
                "required": [
                  "eventType",
                  "legalCase"
                ],
                "properties": {
                  "eventType": {
                    "type": "string",
                    "const": "GivenNameChangeRequest"
                  },
                  "legalCase": {
                    "type": "object",
                    "required": [
                      "identifier"
                    ],
                    "properties": {
                      "identifier": {
                        "type": "string",
                        "$id": "Identifier"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "oldValue",
                  "newValue",
                  "effectivtyStart"
                ],
                "properties": {
                  "oldValue": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "$id": "GivenName"
                  },
                  "newValue": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "$id": "GivenName"
                  },
                  "effectivtyStart": {
                    "anyOf": [
                      {
                        "type": "string",
                        "$id": "DateTime",
                        "format": "datetime"
                      },
                      {
                        "type": "string",
                        "$id": "Date",
                        "format": "date-time"
                      },
                      {
                        "type": "string",
                        "$id": "Month"
                      },
                      {
                        "type": "string",
                        "$id": "Year"
                      }
                    ],
                    "$id": "TemporalPosition"
                  }
                }
              }
            ],
            "$id": "GivenNameChangeRequest"
          },
          {
            "allOf": [
              {
                "allOf": [
                  {
                    "allOf": [
                      {
                        "type": "object",
                        "required": [
                          "identifier",
                          "occurenceTime"
                        ],
                        "properties": {
                          "identifier": {
                            "type": "string",
                            "$id": "Identifier"
                          },
                          "occurenceTime": {
                            "anyOf": [
                              {
                                "type": "string",
                                "$id": "DateTime",
                                "format": "datetime"
                              },
                              {
                                "type": "string",
                                "$id": "Date",
                                "format": "date-time"
                              },
                              {
                                "type": "string",
                                "$id": "Month"
                              },
                              {
                                "type": "string",
                                "$id": "Year"
                              }
                            ],
                            "$id": "TemporalPosition"
                          }
                        }
                      }
                    ],
                    "$id": "LegalEvent"
                  }
                ],
                "$id": "LegalAct"
              },
              {
                "type": "object",
                "required": [
                  "eventType",
                  "legalCase"
                ],
                "properties": {
                  "eventType": {
                    "type": "string",
                    "const": "GivenNameChangeRequest"
                  },
                  "legalCase": {
                    "type": "object",
                    "required": [
                      "identifier"
                    ],
                    "properties": {
                      "identifier": {
                        "type": "string",
                        "$id": "Identifier"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "oldValue",
                  "newValue",
                  "effectivtyStart"
                ],
                "properties": {
                  "oldValue": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "$id": "GivenName"
                  },
                  "newValue": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "$id": "GivenName"
                  },
                  "effectivtyStart": {
                    "anyOf": [
                      {
                        "type": "string",
                        "$id": "DateTime",
                        "format": "datetime"
                      },
                      {
                        "type": "string",
                        "$id": "Date",
                        "format": "date-time"
                      },
                      {
                        "type": "string",
                        "$id": "Month"
                      },
                      {
                        "type": "string",
                        "$id": "Year"
                      }
                    ],
                    "$id": "TemporalPosition"
                  }
                }
              }
            ],
            "$id": "GivenNameChangeOutcome"
          }
        ]
      }
    }
  }
}